{
  "name": "@mgpl-diagnostics/catalog-kit",
  "version": "1.0.0",
  "description": "MGPL Diagnostics test catalog: every test and profile with parameters, units, methods, reference ranges, sample types and INR prices. Typed, zero dependencies, with fast fuzzy search and charm pricing.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "github:mgpl-diagnostics/catalog-kit",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "data": "node scripts/gen-data.mjs",
    "build": "node scripts/gen-data.mjs && tsup",
    "typecheck": "node scripts/gen-data.mjs && tsc --noEmit",
    "test": "node scripts/gen-data.mjs && tsx scripts/test.ts",
    "prepare": "node scripts/gen-data.mjs && tsup"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
